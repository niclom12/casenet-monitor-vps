# =============================================================================
# casenet-monitor — configuration
# Copy to ".env" and fill in. NEVER commit the real .env (it holds secrets).
#   cp .env.example .env && nano .env
# =============================================================================

# ---- What to watch ----------------------------------------------------------
# Full CaseNet docket URL for the case. The "#docket" anchor is fine to include.
# Example (King v. Monsanto, MO 22nd Circuit):
#   https://www.courts.mo.gov/casenet/cases/newHeader.do?inputVO.caseNumber=2622-CC00325&inputVO.courtId=CT22&inputVO.isTicket=false#docket
TARGET_URL=

# Short case number used in alert subjects/labels, e.g. 2622-CC00325
CASE_LABEL=
# Human-friendly case name used in alert text/subjects, e.g. "King v. Monsanto"
CASE_NAME=

# CaseNet search landing page (hit first to look like a normal session).
CASENET_LANDING=https://www.courts.mo.gov/casenet/cases/searchCases.do
# CSS selector that holds the docket table text. CaseNet uses #actualDocketData.
DOCKET_SELECTOR=#actualDocketData

# ---- Polling cadence --------------------------------------------------------
# 1800000 ms = 30 min. Jitter spreads checks out so the pattern isn't robotic.
INTERVAL_MS=1800000
JITTER_PCT=25

# ---- Browser (headful Chromium/Chrome under Xvfb) ---------------------------
# Path to the browser binary. install.sh installs Google Chrome at this path.
BROWSER_BIN=/usr/bin/google-chrome
# Persistent profile dir (keeps Cloudflare clearance cookies between restarts).
BROWSER_PROFILE=/home/casenet/casenet-monitor-vps/browser-profile
# The Xvfb virtual display the browser renders into (set up by casenet-xvfb.service).
DISPLAY=:99
# CDP port the browser exposes for Playwright to connect to.
CDP_PORT=9222
# Optional extra Chromium flags (e.g. proxy). Leave blank for VPN-only egress.
BROWSER_EXTRA_FLAGS=

# ---- VPN guard --------------------------------------------------------------
# Refuse to scrape unless the machine's egress IP geolocates to VPN_COUNTRY.
# This is what keeps you from hitting CaseNet from a non-US IP and getting blocked.
VPN_CHECK=true
VPN_COUNTRY=US

# ---- Phone push (ntfy) — optional but recommended ---------------------------
# Pick a long, unguessable topic and subscribe to it in the ntfy app.
# Anyone who knows the topic can read alerts AND publish to it, so treat as secret.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# How often to push a "still alive" heartbeat so silence is never ambiguous.
HEARTBEAT_HOURS=24

# ---- Failure alerting -------------------------------------------------------
# Email after this many consecutive failed checks; re-mail at most every N hours.
FAIL_ALERT_THRESHOLD=2
FAIL_REALERT_HOURS=12

# ---- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
# Set true only if SMTP_HOST has a valid public TLS cert (recommended if possible).
SMTP_STRICT_TLS=false

# Case / docket-entry alerts ("<case> docket entry") — the people who care about
# the case itself. Comma-separated.
ALERT_TO=

# Operational failure/recovery alerts ("CANNOT REACH DOCKET" / "recovered").
# Usually just the ops owner — keep case-only recipients OFF this list.
# If omitted, falls back to ALERT_TO.
FAIL_ALERT_TO=

# ---- Runtime files (relative to repo dir; usually leave as-is) --------------
STATE_FILE=state.json
DOCKET_FILE=last-docket.txt
SNAPSHOTS_DIR=snapshots
